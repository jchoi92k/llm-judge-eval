# Allowlist-style gitignore: ignore everything at the root by default,
# then explicitly re-include only the files intended for the public repo.
# Local-only material (tool packages, cycle data, analysis notebooks,
# reports, caches) is ignored without needing per-item patterns.

# Ignore everything at the repo root
/*

# --- Allowed: repo meta ---
!/.gitignore
!/.gitattributes
!/.env.example

# --- Allowed: docs ---
!/README.md
!/CONFIG.md
!/TROUBLESHOOTING.md

# --- Allowed: templates and dependencies ---
!/config.toml.example
!/requirements.txt
!/run_evaluation.example.ipynb

# --- Allowed: code and shared inputs ---
!/evaluation_pipeline/
!/inputs/
!/tests/

# Session data stays local even though inputs/ is allowed
/inputs/session_data/

# --- Always ignore, anywhere (including inside allowed dirs) ---
.env
__pycache__/
*.pyc
*.py[cod]
.ipynb_checkpoints/
